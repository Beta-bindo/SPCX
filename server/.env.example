TA_ADMIN_PASSWORD_HASH=generate-with-scripts-hash-admin-password
TA_JWT_SECRET=change-this-random-64-byte-secret
TA_DB_PATH=data/license.db
TA_HOST=127.0.0.1
TA_PORT=8787

# 免授权版「暗号备注自动通过」开关。
# 付费授权服务器强烈建议设为 0，防止用户自行填写暗号备注绕过审核；
# 仅当你确实分发「免授权/上报版」客户端时才设为 1。
TA_NOLICENSE_AUTO_APPROVE=0

# 是否信任反向代理的 X-Forwarded-For（用于登录限流取真实 IP）。
# 仅在确有可信反代（如 Nginx）时设为 1，否则攻击者可伪造该头绕过限流。
TA_TRUST_FORWARDED=0

# CSV 导出最大行数上限，防止超大导出拖垮内存。
TA_EXPORT_MAX_ROWS=100000
